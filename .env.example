# Local development only. Never put real secrets in this file or in Git (spec §20).
APP_ENV=local
DATABASE_URL=postgresql://veyra:veyra@localhost:5432/veyra
OBJECT_STORE_DIR=.data/objects
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
JOB_LEASE_SECONDS=15
QUOTE_TTL_SECONDS=900
MAX_JOB_DURATION_SECONDS=1800
# Sprint guardrail: no single job may authorize more than this (spec §30 step 7).
MAX_JOB_CUSTOMER_USD=1.00
